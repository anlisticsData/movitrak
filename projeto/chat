session_start();
if (!isset($_SESSION['user_id'])) {
    header('Location: login.php');
    exit();
}

// Criar a instância do DAO
$movimentVacanciesDAO = new MovimentVacanciesDAO($pdo);

// Buscar dados para o gráfico e as seções
$movimentos_ultimos_dias = $movimentVacanciesDAO->getMovimentosUltimosDias(); // Função que busca dados para o gráfico
$movimentos_recentes = $movimentVacanciesDAO->getMovimentosRecentes(); // Função que busca os movimentos mais recentes
//$movimentos_do_dia = $movimentVacanciesDAO->getMovimentosDoDia(); // Função que busca os movimentos do dia


$movimentos_do_dia = $movimentVacanciesDAO->getResumoMovimentosDoDia();


 
// Buscar o status das vagas (ocupadas e livres)
$vagas_status = $movimentVacanciesDAO->getVagasStatus(); // Retorna [ocupadas => x, livres => y]

// Buscar a vaga com o maior tempo de permanência
$vaga_maior_tempo = $movimentVacanciesDAO->getVagaMaiorTempo(); // Retorna [vaga_id, tempo_permanencia]

// Buscar a vaga com maior frequência de movimentações
$vaga_maior_frequencia = $movimentVacanciesDAO->getVagaMaiorFrequencia(); // Retorna [vaga_id, frequencia]

// Agora, você precisa extrair os dias e movimentos para passar para o gráfico
$movimentos_dias = [];
$movimentos_contagem = [];

foreach ($movimentos_ultimos_dias as $movimento) {
    // Aqui você extrai a data e a contagem de movimentos
    $dia = date('D', strtotime($movimento['created_at']));  // 'D' traz o nome abreviado do dia da semana (Seg, Ter, etc.)
    if (!in_array($dia, $movimentos_dias)) {
        $movimentos_dias[] = $dia;  // Adiciona o dia
        $movimentos_contagem[] = 1;  // Inicia a contagem de movimentos para esse dia
    } else {
        $index = array_search($dia, $movimentos_dias);  // Encontra o índice do dia
        $movimentos_contagem[$index]++;  // Incrementa a contagem
    }
}
